          "Text": "Ángel de la Guarda"
        },
        {
          "Type": "Paragraph",
          "Order": 2,
          "Text": "Ángel de la guarda,\ndulce compañía,\nno me desampares\nni de noche ni de día.",
          "FontStyle": "Italic"
        },
        {
          "Type": "Paragraph",
          "Order": 3,
          "Text": "No me dejes solo\nnunca en el camino;\nllévame de la mano\nhasta llegar al destino.",
          "FontStyle": "Italic"
        },
        {
          "Type": "Paragraph",
          "Order": 4,
          "Text": "Amén.",
          "FontStyle": "Bold",
          "Alignment": "Center"
        }
      ]
    }
  ]
}