        {
          "Type": "Paragraph",
          "Order": 5,
          "Text": "Santa María, Madre de Dios,\nruega por nosotros, pecadores,\nahora y en la hora de nuestra muerte.",
          "FontStyle": "Italic"
        },
        {
          "Type": "Paragraph",
          "Order": 6,
          "Text": "Amén.",
          "FontStyle": "Bold",
          "Alignment": "Center"
        }
      ]
