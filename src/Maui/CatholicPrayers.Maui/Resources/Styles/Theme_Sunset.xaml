<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="false" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Sunset Theme: Warm Golden Amber ── -->
    <Color x:Key="PrayAppPageBgColor">#FFF7ED</Color>
    <Color x:Key="PrayAppPageBgGradientStart">#FFF7ED</Color>
    <Color x:Key="PrayAppPageBgGradientEnd">#FEF3C7</Color>

    <Color x:Key="PrayAppH1TextColor">#7C2D12</Color>
    <Color x:Key="PrayAppH2TextColor">#92400E</Color>
    <Color x:Key="PrayAppH3TextColor">#B45309</Color>
    <Color x:Key="PrayAppBodyTextColor">#431407</Color>
    <Color x:Key="PrayAppSubtitleTextColor">#9A5820</Color>
    <Color x:Key="PrayAppAccentColor">#F97316</Color>
    <Color x:Key="PrayAppResponseTextColor">#7C2D12</Color>

    <Color x:Key="PrayAppCardBgColor">#FFFBF0</Color>
    <Color x:Key="PrayAppCardBorderColor">#FDE68A</Color>
    <Color x:Key="PrayAppCardShadowColor">#20000000</Color>
    <Color x:Key="PrayAppCardGlowColor">#40F97316</Color>

    <Color x:Key="PrayAppTileBgGradientStart">#FFFBF0</Color>
    <Color x:Key="PrayAppTileBgGradientEnd">#FEF3C7</Color>
    <Color x:Key="PrayAppTileBorderColor">#FDE68A</Color>
    <Color x:Key="PrayAppTileIconColor">#F97316</Color>
    <Color x:Key="PrayAppTileTitleColor">#7C2D12</Color>

    <Color x:Key="PrayAppNavButtonBgColor">#EA580C</Color>
    <Color x:Key="PrayAppNavButtonFgColor">#FFFFFF</Color>
    <Color x:Key="PrayAppNavButtonDisabledBgColor">#FEF3C7</Color>
    <Color x:Key="PrayAppNavButtonDisabledFgColor">#FCA26A</Color>
    <Color x:Key="PrayAppToolbarBgColor">#FFFBF0</Color>
    <Color x:Key="PrayAppToolbarBorderColor">#FDE68A</Color>

    <Color x:Key="PrayAppShellBgColor">#FFF7ED</Color>
    <Color x:Key="PrayAppShellFgColor">#431407</Color>
    <Color x:Key="PrayAppShellTitleColor">#F97316</Color>
    <Color x:Key="PrayAppShellBorderColor">#FDE68A</Color>
    <Color x:Key="PrayAppShellSelectedItemBgColor">#FEF3C7</Color>
    <Color x:Key="PrayAppShellSelectedItemFgColor">#F97316</Color>

    <Color x:Key="PrayAppStepCompletedColor">#F97316</Color>
    <Color x:Key="PrayAppStepActiveColor">#DC2626</Color>
    <Color x:Key="PrayAppStepInactiveColor">#FEF3C7</Color>
    <Color x:Key="PrayAppStepConnectorColor">#FDE68A</Color>
    <Color x:Key="PrayAppDividerColor">#FDE68A</Color>

    <Color x:Key="PrayAppSearchBgColor">#FFFBF0</Color>
    <Color x:Key="PrayAppSearchTextColor">#431407</Color>
    <Color x:Key="PrayAppSearchPlaceholderColor">#9CA3AF</Color>
    <Color x:Key="PrayAppSearchBorderColor">#FDE68A</Color>

    <Color x:Key="PrayAppSettingsSectionHeaderColor">#F97316</Color>
    <Color x:Key="PrayAppSettingsRowBgColor">#FFFBF0</Color>
    <Color x:Key="PrayAppSettingsLabelColor">#431407</Color>
    <Color x:Key="PrayAppSettingsValueColor">#9A5820</Color>

    <LinearGradientBrush x:Key="PrayAppPageBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="{StaticResource PrayAppPageBgGradientStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource PrayAppPageBgGradientEnd}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrayAppTileBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource PrayAppTileBgGradientStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource PrayAppTileBgGradientEnd}" />
    </LinearGradientBrush>

</ResourceDictionary>
