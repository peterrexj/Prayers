<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="false" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Common Styles — applied on every theme switch -->
    <x:Double x:Key="PrayAppBaseFontSize">16</x:Double>
    <x:String x:Key="PrayAppDefaultFontFamily">Lato</x:String>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrayAppPageBgColor}" />
    </Style>

    <Style x:Key="PrayAppH1LabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource PrayAppDefaultFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrayAppH1TextColor}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style x:Key="PrayAppH2LabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource PrayAppDefaultFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrayAppH2TextColor}" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <Style x:Key="PrayAppH3LabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource PrayAppDefaultFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrayAppH3TextColor}" />
        <Setter Property="Margin" Value="0,8,0,2" />
    </Style>

    <Style x:Key="PrayAppBodyLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource PrayAppDefaultFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{DynamicResource PrayAppBodyTextColor}" />
        <Setter Property="LineHeight" Value="1.5" />
        <Setter Property="Margin" Value="0,2,0,2" />
    </Style>

    <Style x:Key="PrayAppQuoteStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource PrayAppDefaultFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Italic" />
        <Setter Property="TextColor" Value="{DynamicResource PrayAppAccentColor}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>

    <Style x:Key="PrayAppCardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrayAppCardBgColor}" />
        <Setter Property="Stroke" Value="{DynamicResource PrayAppCardBorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="8,6" />
    </Style>

    <Style x:Key="PrayAppNavButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrayAppNavButtonBgColor}" />
        <Setter Property="TextColor" Value="{DynamicResource PrayAppNavButtonFgColor}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style x:Key="PrayAppToolbarButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource PrayAppAccentColor}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
    </Style>

</ResourceDictionary>
