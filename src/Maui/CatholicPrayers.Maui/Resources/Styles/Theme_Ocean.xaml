<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="false" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Ocean Theme: Serene Blue ── -->
    <Color x:Key="PrayAppPageBgColor">#EFF6FF</Color>
    <Color x:Key="PrayAppPageBgGradientStart">#EFF6FF</Color>
    <Color x:Key="PrayAppPageBgGradientEnd">#DBEAFE</Color>

    <Color x:Key="PrayAppH1TextColor">#1E3A5F</Color>
    <Color x:Key="PrayAppH2TextColor">#1D4ED8</Color>
    <Color x:Key="PrayAppH3TextColor">#2563EB</Color>
    <Color x:Key="PrayAppBodyTextColor">#1E3A5F</Color>
    <Color x:Key="PrayAppSubtitleTextColor">#3B6FA0</Color>
    <Color x:Key="PrayAppAccentColor">#0EA5E9</Color>
    <Color x:Key="PrayAppResponseTextColor">#0369A1</Color>

    <Color x:Key="PrayAppCardBgColor">#FFFFFF</Color>
    <Color x:Key="PrayAppCardBorderColor">#BFDBFE</Color>
    <Color x:Key="PrayAppCardShadowColor">#20000000</Color>
    <Color x:Key="PrayAppCardGlowColor">#400EA5E9</Color>

    <Color x:Key="PrayAppTileBgGradientStart">#FFFFFF</Color>
    <Color x:Key="PrayAppTileBgGradientEnd">#DBEAFE</Color>
    <Color x:Key="PrayAppTileBorderColor">#BFDBFE</Color>
    <Color x:Key="PrayAppTileIconColor">#0EA5E9</Color>
    <Color x:Key="PrayAppTileTitleColor">#1E3A5F</Color>

    <Color x:Key="PrayAppNavButtonBgColor">#0284C7</Color>
    <Color x:Key="PrayAppNavButtonFgColor">#FFFFFF</Color>
    <Color x:Key="PrayAppNavButtonDisabledBgColor">#DBEAFE</Color>
    <Color x:Key="PrayAppNavButtonDisabledFgColor">#7DD3FC</Color>
    <Color x:Key="PrayAppToolbarBgColor">#FFFFFF</Color>
    <Color x:Key="PrayAppToolbarBorderColor">#BFDBFE</Color>

    <Color x:Key="PrayAppShellBgColor">#EFF6FF</Color>
    <Color x:Key="PrayAppShellFgColor">#1E3A5F</Color>
    <Color x:Key="PrayAppShellTitleColor">#0EA5E9</Color>
    <Color x:Key="PrayAppShellBorderColor">#BFDBFE</Color>
    <Color x:Key="PrayAppShellSelectedItemBgColor">#DBEAFE</Color>
    <Color x:Key="PrayAppShellSelectedItemFgColor">#0EA5E9</Color>

    <Color x:Key="PrayAppStepCompletedColor">#0EA5E9</Color>
    <Color x:Key="PrayAppStepActiveColor">#F59E0B</Color>
    <Color x:Key="PrayAppStepInactiveColor">#DBEAFE</Color>
    <Color x:Key="PrayAppStepConnectorColor">#BFDBFE</Color>
    <Color x:Key="PrayAppDividerColor">#BFDBFE</Color>

    <Color x:Key="PrayAppSearchBgColor">#FFFFFF</Color>
    <Color x:Key="PrayAppSearchTextColor">#1E3A5F</Color>
    <Color x:Key="PrayAppSearchPlaceholderColor">#9CA3AF</Color>
    <Color x:Key="PrayAppSearchBorderColor">#BFDBFE</Color>

    <Color x:Key="PrayAppSettingsSectionHeaderColor">#0EA5E9</Color>
    <Color x:Key="PrayAppSettingsRowBgColor">#FFFFFF</Color>
    <Color x:Key="PrayAppSettingsLabelColor">#1E3A5F</Color>
    <Color x:Key="PrayAppSettingsValueColor">#3B6FA0</Color>

    <LinearGradientBrush x:Key="PrayAppPageBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="{StaticResource PrayAppPageBgGradientStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource PrayAppPageBgGradientEnd}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrayAppTileBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource PrayAppTileBgGradientStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource PrayAppTileBgGradientEnd}" />
    </LinearGradientBrush>

</ResourceDictionary>
