<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource PrayAppAccentColor}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource PrayAppDefaultFontFamily}" />
        <Setter Property="TextColor" Value="{DynamicResource PrayAppBodyTextColor}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="{DynamicResource PrayAppDefaultFontFamily}" />
        <Setter Property="TextColor" Value="{DynamicResource PrayAppSearchTextColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrayAppSearchBgColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource PrayAppSearchPlaceholderColor}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="FontFamily" Value="{DynamicResource PrayAppDefaultFontFamily}" />
        <Setter Property="TextColor" Value="{DynamicResource PrayAppSearchTextColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrayAppSearchBgColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource PrayAppSearchPlaceholderColor}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource PrayAppDefaultFontFamily}" />
        <Setter Property="TextColor" Value="{DynamicResource PrayAppNavButtonFgColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrayAppNavButtonBgColor}" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource PrayAppShellBgColor}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource PrayAppShellFgColor}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource PrayAppShellTitleColor}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource PrayAppNavButtonDisabledFgColor}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource PrayAppSubtitleTextColor}" />
        <Setter Property="Shell.FlyoutBackgroundColor" Value="{DynamicResource PrayAppPageBgColor}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource PrayAppShellBgColor}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource PrayAppShellFgColor}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource PrayAppSubtitleTextColor}" />
    </Style>

</ResourceDictionary>
