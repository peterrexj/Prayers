        <GradientStop Offset="0.0" Color="#0D1B2A" />
        <GradientStop Offset="1.0" Color="#1B2A3B" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrayAppTileBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#1A2844" />
        <GradientStop Offset="1.0" Color="#0D1B2A" />
    </LinearGradientBrush>
