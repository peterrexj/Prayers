<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CatholicPrayers.Maui.ViewModels"
             x:Class="CatholicPrayers.Maui.Views.BookPage"
             x:DataType="vm:BookViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PrayAppPageBgColor}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource PrayAppToolbarBgColor}"
                Stroke="{DynamicResource PrayAppToolbarBorderColor}"
                StrokeThickness="0,0,0,1"
                StrokeShape="Rectangle"
                Padding="8,8,16,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <!-- Back / back-to-chapters -->
                <Button Grid.Column="0"
                        Text="&#xf053;"
                        FontFamily="FontAwesome5Solid"
                        FontSize="18"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrayAppAccentColor}"
                        Command="{Binding GoBackCommand}"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0" />
                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" Margin="4,0">
                    <Label Text="{Binding PageTitle}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrayAppH1TextColor}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding PageSubtitle}"
                           FontSize="12"
                           TextColor="{DynamicResource PrayAppSubtitleTextColor}" />
                </StackLayout>
                <!-- Chapter list (verse view only) -->
                <Button Grid.Column="2"
                        Text="&#xf0ca;"
                        FontFamily="FontAwesome5Solid"
                        FontSize="16"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrayAppAccentColor}"
                        Command="{Binding BackToChaptersCommand}"
                        IsVisible="{Binding ShowVerseView}"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0" />
                <!-- Favourite heart (verse view only) -->
                <Button Grid.Column="3"
                        Text="&#xf004;"
                        FontFamily="FontAwesome5Solid"
                        FontSize="18"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrayAppSubtitleTextColor}"
                        Command="{Binding ToggleChapterFavCommand}"
                        IsVisible="{Binding ShowVerseView}"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsChapterFavourite}" Value="True">
                            <Setter Property="TextColor" Value="#E53935" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <!-- Bible home -->
                <Button Grid.Column="4"
                        Text="&#xf02d;"
                        FontFamily="FontAwesome5Solid"
                        FontSize="16"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrayAppAccentColor}"
                        Command="{Binding GoToBibleHomeCommand}"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0" />
                <!-- App home -->
                <Button Grid.Column="5"
                        Text="&#xf015;"
                        FontFamily="FontAwesome5Solid"
                        FontSize="16"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrayAppAccentColor}"
                        Command="{Binding GoToAppHomeCommand}"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0" />
            </Grid>
        </Border>

        <!-- ── Chapter grid (shown by default) ── -->
        <ScrollView Grid.Row="1" IsVisible="{Binding ShowChapterList}">
            <StackLayout x:Name="chapterStack"
                         Padding="16,12,16,32"
                         Spacing="0" />
        </ScrollView>

        <!-- ── Verse view ── -->
        <ScrollView Grid.Row="1" IsVisible="{Binding ShowVerseView}">
            <StackLayout x:Name="verseStack"
                         Padding="20,16,20,40"
                         Spacing="0" />
        </ScrollView>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{DynamicResource PrayAppAccentColor}"
                               HeightRequest="48"
                               WidthRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
