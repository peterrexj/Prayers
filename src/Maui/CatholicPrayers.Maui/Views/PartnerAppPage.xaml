<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CatholicPrayers.Maui.ViewModels"
             x:Class="CatholicPrayers.Maui.Views.PartnerAppPage"
             x:DataType="vm:PartnerAppViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PrayAppPageBgColor}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource PrayAppToolbarBgColor}"
                Stroke="{DynamicResource PrayAppToolbarBorderColor}"
                StrokeThickness="0,0,0,1"
                StrokeShape="Rectangle"
                Padding="8,8,16,8">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Text="&#xf053;"
                        FontFamily="FontAwesome5Solid"
                        FontSize="18"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrayAppAccentColor}"
                        Command="{Binding GoBackCommand}"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0" />
                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" Margin="4,0">
                    <Label Text="{Binding PageTitle}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrayAppH1TextColor}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding PageSubtitle}"
                           FontSize="12"
                           TextColor="{DynamicResource PrayAppSubtitleTextColor}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                </StackLayout>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,20,20,48" Spacing="20">

                <!-- Hero card -->
                <Grid>
                    <Border BackgroundColor="{DynamicResource PrayAppCardBgColor}"
                            Stroke="{DynamicResource PrayAppCardBorderColor}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16">
                        <Border.Shadow>
                            <Shadow Brush="{DynamicResource PrayAppAccentColor}"
                                    Offset="0,6"
                                    Radius="18"
                                    Opacity="0.30" />
                        </Border.Shadow>
                        <StackLayout Spacing="0">

                            <!-- Banner image -->
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16,16,0,0"
                                    HeightRequest="200"
                                    HorizontalOptions="Fill">
                                <Image Source="{Binding AppImage}"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />
                            </Border>

                            <!-- Name + short description -->
                            <StackLayout Padding="20,16,20,20" Spacing="6">
                                <Label Text="{Binding PageTitle}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource PrayAppH1TextColor}" />
                                <Label Text="{Binding ShortDescription}"
                                       FontSize="14"
                                       TextColor="{DynamicResource PrayAppH3TextColor}"
                                       LineHeight="1.5"
                                       LineBreakMode="WordWrap" />
                            </StackLayout>

                        </StackLayout>
                    </Border>

                    <!-- App icon badge overlapping top-right corner of banner -->
                    <Border BackgroundColor="{DynamicResource PrayAppCardBgColor}"
                            Stroke="{DynamicResource PrayAppCardBorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            HeightRequest="60"
                            WidthRequest="60"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,10,12,0">
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,4"
                                    Radius="10"
                                    Opacity="0.35" />
                        </Border.Shadow>
                        <Image Source="{Binding AppIconImage}"
                               Aspect="AspectFit"
                               HeightRequest="52"
                               WidthRequest="52"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Full description -->
                <Label Text="{Binding FullDescription}"
                       FontSize="15"
                       TextColor="{DynamicResource PrayAppBodyTextColor}"
                       LineHeight="1.7"
                       LineBreakMode="WordWrap" />

                <!-- Download button -->
                <Button Text="Download App"
                        FontSize="16"
                        FontAttributes="Bold"
                        BackgroundColor="{DynamicResource PrayAppAccentColor}"
                        TextColor="White"
                        CornerRadius="24"
                        HeightRequest="52"
                        Command="{Binding OpenStoreCommand}" />

            </StackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{DynamicResource PrayAppAccentColor}"
                               HeightRequest="48"
                               WidthRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
