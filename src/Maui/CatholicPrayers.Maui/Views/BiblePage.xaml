<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CatholicPrayers.Maui.ViewModels"
             x:Class="CatholicPrayers.Maui.Views.BiblePage"
             x:DataType="vm:BibleViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PrayAppPageBgColor}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource PrayAppToolbarBgColor}"
                Stroke="{DynamicResource PrayAppToolbarBorderColor}"
                StrokeThickness="0,0,0,1"
                StrokeShape="Rectangle"
                Padding="8,8,16,8">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Text="&#xf053;"
                        FontFamily="FontAwesome5Solid"
                        FontSize="18"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrayAppAccentColor}"
                        Command="{Binding GoBackCommand}"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0" />
                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" Margin="4,0">
                    <Label Text="The Bible"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrayAppH1TextColor}" />
                    <Label Text="Douay-Rheims · 73 Books"
                           FontSize="12"
                           TextColor="{DynamicResource PrayAppSubtitleTextColor}" />
                </StackLayout>
            </Grid>
        </Border>

        <!-- ── Search bar ── -->
        <Border Grid.Row="1"
                BackgroundColor="{DynamicResource PrayAppToolbarBgColor}"
                Stroke="{DynamicResource PrayAppToolbarBorderColor}"
                StrokeThickness="0,0,0,1"
                StrokeShape="Rectangle"
                Padding="16,8,16,10">
            <Grid ColumnDefinitions="*,Auto">
                <Border Grid.Column="0"
                        BackgroundColor="{DynamicResource PrayAppCardBgColor}"
                        Stroke="{DynamicResource PrayAppCardBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="10,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Text="&#xf002;"
                               FontFamily="FontAwesome5Solid"
                               FontSize="14"
                               TextColor="{DynamicResource PrayAppSubtitleTextColor}"
                               VerticalOptions="Center"
                               Margin="0,0,8,0" />
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Search the Bible…"
                               PlaceholderColor="{DynamicResource PrayAppSubtitleTextColor}"
                               TextColor="{DynamicResource PrayAppBodyTextColor}"
                               BackgroundColor="Transparent"
                               FontSize="15"
                               HeightRequest="40"
                               ReturnType="Search" />
                        <Button Grid.Column="2"
                                Text="&#xf00d;"
                                FontFamily="FontAwesome5Solid"
                                FontSize="12"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource PrayAppSubtitleTextColor}"
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding IsSearchActive}"
                                HeightRequest="36"
                                WidthRequest="36"
                                Padding="0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ── OT / NT toggle (hidden during search) ── -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              BackgroundColor="{DynamicResource PrayAppToolbarBgColor}"
              Padding="16,8,16,8"
              IsVisible="{Binding IsSearchActive, Converter={StaticResource InvertBool}}">
            <Button Grid.Column="0"
                    x:Name="btnOT"
                    Text="Old Testament"
                    FontSize="14"
                    CornerRadius="8"
                    HeightRequest="38"
                    Command="{Binding SetTestamentCommand}"
                    CommandParameter="OT"
                    Margin="0,0,4,0" />
            <Button Grid.Column="1"
                    x:Name="btnNT"
                    Text="New Testament"
                    FontSize="14"
                    CornerRadius="8"
                    HeightRequest="38"
                    Command="{Binding SetTestamentCommand}"
                    CommandParameter="NT"
                    Margin="4,0,0,0" />
        </Grid>

        <!-- ── Search results ── -->
        <ScrollView Grid.Row="3"
                    IsVisible="{Binding IsSearchActive}">
            <StackLayout x:Name="searchStack"
                         Padding="16,12,16,32"
                         Spacing="0" />
        </ScrollView>

        <!-- ── Book lists ── -->
        <ScrollView Grid.Row="3"
                    IsVisible="{Binding IsSearchActive, Converter={StaticResource InvertBool}}">
            <StackLayout x:Name="bookStack"
                         Padding="16,12,16,32"
                         Spacing="6" />
        </ScrollView>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="4"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{DynamicResource PrayAppAccentColor}"
                               HeightRequest="48"
                               WidthRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
