<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CatholicPrayers.Maui.ViewModels"
             x:Class="CatholicPrayers.Maui.Views.LinkDetailPage"
             x:DataType="vm:LinkDetailViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PrayAppPageBgColor}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource PrayAppToolbarBgColor}"
                Stroke="{DynamicResource PrayAppToolbarBorderColor}"
                StrokeThickness="0,0,0,1"
                StrokeShape="Rectangle"
                Padding="8,8,16,8">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Text="&#xf053;"
                        FontFamily="FontAwesome5Solid"
                        FontSize="18"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrayAppAccentColor}"
                        Command="{Binding GoBackCommand}"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0" />
                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" Margin="4,0">
                    <Label Text="{Binding PageTitle}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrayAppH1TextColor}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding PageSubtitle}"
                           FontSize="12"
                           TextColor="{DynamicResource PrayAppSubtitleTextColor}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                </StackLayout>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="24,24,24,40" Spacing="24">

                <!-- External link icon card -->
                <Border BackgroundColor="{DynamicResource PrayAppCardBgColor}"
                        Stroke="{DynamicResource PrayAppCardBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="24,20"
                        HorizontalOptions="Center">
                    <StackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="&#xf35d;"
                               FontFamily="FontAwesome5Solid"
                               FontSize="48"
                               TextColor="{DynamicResource PrayAppAccentColor}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding PageTitle}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource PrayAppH1TextColor}"
                               HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Border>

                <!-- Description -->
                <Label Text="{Binding Description}"
                       FontSize="15"
                       TextColor="{DynamicResource PrayAppBodyTextColor}"
                       LineHeight="1.6"
                       IsVisible="{Binding Description, Converter={x:StaticResource StringToBoolConverter}}" />

                <!-- Open link button -->
                <Button Text="&#xf35d;  Open App / Website"
                        FontFamily="FontAwesome5Solid"
                        FontSize="16"
                        BackgroundColor="{DynamicResource PrayAppAccentColor}"
                        TextColor="White"
                        CornerRadius="22"
                        HeightRequest="48"
                        Command="{Binding OpenLinkCommand}"
                        IsVisible="{Binding Url, Converter={x:StaticResource StringToBoolConverter}}" />

                <!-- URL hint -->
                <Label Text="{Binding Url}"
                       FontSize="12"
                       TextColor="{DynamicResource PrayAppSubtitleTextColor}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="CharacterWrap"
                       IsVisible="{Binding Url, Converter={x:StaticResource StringToBoolConverter}}" />

            </StackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{DynamicResource PrayAppAccentColor}"
                               HeightRequest="48"
                               WidthRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
