<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android36.0;net9.0-ios18.0;net9.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>CatholicPrayers.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

    <!-- App info -->
    <ApplicationTitle>Catholic Prayers</ApplicationTitle>
    <ApplicationId>com.pj.catholicprayersapp</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Platform minima -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

    <!-- iOS release signing -->
    <CodesignKey Condition="$(TargetFramework.Contains('-ios')) AND '$(Configuration)' == 'Release'">Apple Distribution: Peter Joseph (5PNCUV7LZ5)</CodesignKey>
    <CodesignProvision Condition="$(TargetFramework.Contains('-ios')) AND '$(Configuration)' == 'Release'">Automatic:Distribution</CodesignProvision>
    <ArchiveOnBuild Condition="$(TargetFramework.Contains('-ios')) AND '$(Configuration)' == 'Release'">true</ArchiveOnBuild>
    <RuntimeIdentifier Condition="$(TargetFramework.Contains('-ios')) AND '$(Configuration)' == 'Release'">ios-arm64</RuntimeIdentifier>

    <!-- Android release signing -->
    <AndroidSigningKeyStore Condition="$(TargetFramework.Contains('-android')) AND '$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)..\..\..\Resources\catholicsaints.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias Condition="$(TargetFramework.Contains('-android')) AND '$(Configuration)' == 'Release'">keyalias.alias</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass Condition="$(TargetFramework.Contains('-android')) AND '$(Configuration)' == 'Release'">CatholicSaintsPassword@01</AndroidSigningKeyPass>
    <AndroidSigningStorePass Condition="$(TargetFramework.Contains('-android')) AND '$(Configuration)' == 'Release'">CatholicSaintsPassword@01</AndroidSigningStorePass>
    <AndroidPackageFormat Condition="$(TargetFramework.Contains('-android')) AND '$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
  </PropertyGroup>

  <!-- Theme XAML as EmbeddedResource so they can be loaded at runtime for theme switching -->
  <ItemGroup>
    <MauiXaml Remove="Resources/Styles/Theme_Styles_Common.xaml" />
    <MauiXaml Remove="Resources/Styles/Theme_Dark.xaml" />
    <MauiXaml Remove="Resources/Styles/Theme_Light.xaml" />
    <MauiXaml Remove="Resources/Styles/Theme_Forest.xaml" />
    <MauiXaml Remove="Resources/Styles/Theme_Candy.xaml" />
    <MauiXaml Remove="Resources/Styles/Theme_Sunset.xaml" />
    <MauiXaml Remove="Resources/Styles/Theme_Ocean.xaml" />
    <EmbeddedResource Include="Resources/Styles/Theme_Styles_Common.xaml" />
    <EmbeddedResource Include="Resources/Styles/Theme_Dark.xaml" />
    <EmbeddedResource Include="Resources/Styles/Theme_Light.xaml" />
    <EmbeddedResource Include="Resources/Styles/Theme_Forest.xaml" />
    <EmbeddedResource Include="Resources/Styles/Theme_Candy.xaml" />
    <EmbeddedResource Include="Resources/Styles/Theme_Sunset.xaml" />
    <EmbeddedResource Include="Resources/Styles/Theme_Ocean.xaml" />
  </ItemGroup>


  <!-- Splash -->
  <ItemGroup>
    <MauiSplashScreen Include="Resources/Splash/splash.png" Color="#0D1B2A" BaseSize="128,128" />
  </ItemGroup>

  <!-- Images -->
  <ItemGroup>
    <MauiImage Include="Resources/Images/*" />
  </ItemGroup>

  <!-- Fonts -->
  <ItemGroup>
    <MauiFont Include="Resources/Fonts/*" />
  </ItemGroup>

  <!-- Raw assets -->
  <ItemGroup>
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Syncfusion.Maui.Core" Version="33.2.6" />
    <PackageReference Include="Syncfusion.Maui.Buttons" Version="33.2.6" />
    <PackageReference Include="Syncfusion.Maui.ListView" Version="33.2.6" />
    <PackageReference Include="Syncfusion.Maui.Inputs" Version="33.2.6" />
    <PackageReference Include="Syncfusion.Maui.ProgressBar" Version="33.2.6" />
    <PackageReference Include="Pj.Library" Version="1.0.4.33" />
    <PackageReference Include="Microsoft.AppCenter.Analytics" Version="5.0.3" Condition="$(TargetFramework.Contains('-android'))" />
    <PackageReference Include="Microsoft.AppCenter.Crashes" Version="5.0.3" Condition="$(TargetFramework.Contains('-android'))" />
  </ItemGroup>

</Project>
