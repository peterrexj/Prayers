<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <DefineConstants>UNIT_TESTING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.1.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.2.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Pj.Library" Version="1.0.4.33" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <!-- Syncfusion needed for PrayerProgressModel (StepStatus enum) -->
    <PackageReference Include="Syncfusion.Maui.ProgressBar" Version="33.2.6" />
    <!-- DI extensions for GetService<T>/GetRequiredService<T> in ServiceLocator -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- Mirror MAUI global usings so source files compile without explicit imports -->
  <ItemGroup>
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Storage" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!-- Compile shared source files directly (avoids MAUI TFM dependency) -->
  <ItemGroup>
    <Compile Include="../../Prayers.StJoseph.Maui/Models/**/*.cs" LinkBase="Models" />
    <Compile Include="../../Prayers.StJoseph.Maui/ViewModels/BasePropertyChangeModel.cs" LinkBase="ViewModels" />
    <Compile Include="../../Prayers.StJoseph.Maui/ViewModels/BaseViewModel.cs" LinkBase="ViewModels" />
    <Compile Include="../../Prayers.StJoseph.Maui/ViewModels/SettingsViewModel.cs" LinkBase="ViewModels" />
    <Compile Include="../../Prayers.StJoseph.Maui/ViewModels/StyleModelDefault.cs" LinkBase="ViewModels" />
    <Compile Include="../../Prayers.StJoseph.Maui/ViewModels/MainViewModel.cs" LinkBase="ViewModels" />
    <Compile Include="../../Prayers.StJoseph.Maui/ViewModels/PrayerProgressModel.cs" LinkBase="ViewModels" />
    <Compile Include="../../Prayers.StJoseph.Maui/ViewModels/PrayerViewModel.cs" LinkBase="ViewModels" />
    <Compile Include="../../Prayers.StJoseph.Maui/Services/ILocalStorageService.cs" LinkBase="Services" />
    <Compile Include="../../Prayers.StJoseph.Maui/Services/IAudioService.cs" LinkBase="Services" />
    <Compile Include="../../Prayers.StJoseph.Maui/Services/IThemeService.cs" LinkBase="Services" />
    <Compile Include="../../Prayers.StJoseph.Maui/Services/IAppInformationService.cs" LinkBase="Services" />
    <Compile Include="../../Prayers.StJoseph.Maui/Services/ServiceLocator.cs" LinkBase="Services" />
    <Compile Include="../../Prayers.StJoseph.Maui/Services/ThemeService.cs" LinkBase="Services" />
    <Compile Include="../../Prayers.StJoseph.Maui/Services/LocalStorageService.cs" LinkBase="Services" />
    <Compile Include="../../Prayers.StJoseph.Maui/Services/SharedServices.cs" LinkBase="Services" />
    <Compile Include="../../Prayers.StJoseph.Maui/Extensions/ExceptionHandler.cs" LinkBase="Extensions" />
    <Compile Include="../../Prayers.StJoseph.Maui/Extensions/SettingsHelper.cs" LinkBase="Extensions" />
    <Compile Include="../../Prayers.StJoseph.Maui/Extensions/ViewHelper.cs" LinkBase="Extensions" />
  </ItemGroup>

</Project>
