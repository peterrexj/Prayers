<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Shell theme colors — updated at runtime by ThemeService -->
    <Color x:Key="AppShellBgColor">#1B2631</Color>
    <Color x:Key="AppShellFgColor">#B3B6B7</Color>
    <Color x:Key="AppShellTitleColor">#B3B6B7</Color>
    <Color x:Key="AppShellDisabledColor">#979A9A</Color>
    <Color x:Key="AppShellUnselectedColor">#5D6D7E</Color>
    <Color x:Key="AppShellTabBarBackgroundColor">#1B2631</Color>
    <Color x:Key="AppShellTabBarForegroundColor">#B3B6B7</Color>
    <Color x:Key="AppShellTabBarUnselectedColor">#5D6D7E</Color>
    <Color x:Key="AppShellTabBarDisabledColor">#979A9A</Color>
    <Color x:Key="AppShellTabBarTitleColor">#21618C</Color>
    <Color x:Key="AppShellBackgroundColor">#447e58</Color>

    <!-- Generic -->
    <Color x:Key="PrimaryColor">#0B5345</Color>
    <Color x:Key="SecondaryColor">#1A5276</Color>
    <Color x:Key="DarkPageBg">#1B2631</Color>
    <Color x:Key="LightPageBg">#FFFFFF</Color>

</ResourceDictionary>
