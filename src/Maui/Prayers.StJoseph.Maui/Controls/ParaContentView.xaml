<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Prayers.StJoseph.Maui.Controls.ParaContentView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Prayers.StJoseph.Maui.Converters">
    <ContentView.Resources>
        <converters:StringToColorConverter x:Key="ColorConv" />
    </ContentView.Resources>
    <StackLayout>
        <Label
            x:Name="lblContentJustify"
            IsVisible="False"
            LineHeight="1.2"
            Margin="30,10,30,10" />
        <Label
            x:Name="lblContentNormal"
            IsVisible="True"
            LineHeight="1.2"
            Margin="30,10,30,0" />
    </StackLayout>
</ContentView>
