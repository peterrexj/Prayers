<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Prayers.StJoseph.Maui.Controls.ParaBulletView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid Margin="15,2,30,0" ColumnSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label
            x:Name="lblNumber"
            Grid.Column="0"
            Margin="0,2,0,0"
            FontAttributes="Bold"
            FontFamily="OpenSansSemibold"
            HorizontalTextAlignment="Center"
            LineHeight="1.2"
            VerticalTextAlignment="Start"
            WidthRequest="26" />
        <Label
            x:Name="lblContentJustify"
            Grid.Column="1"
            IsVisible="False"
            LineHeight="1.2" />
        <Label
            x:Name="lblContentNormal"
            Grid.Column="1"
            IsVisible="True"
            LineHeight="1.2" />
    </Grid>
</ContentView>
